# Copy to .env and fill with real random values: `make keys` or `python scripts/gen_keys.py`
# NEVER commit .env.

# --- Secrets (generate, do not reuse these placeholders) ---
HMAC_KEY=replace-me-with-64-hex-chars
VAULT_KEY=replace-me-with-a-fernet-key
JWT_SECRET=replace-me-with-64-hex-chars
REGISTRY_API_KEY=replace-me-with-32-hex-chars
ISSUER_API_KEY=replace-me-with-32-hex-chars

# --- Database ---
DATABASE_URL=sqlite:///./apaar.db
REGISTRY_DATABASE_URL=sqlite:///./registry.db
ISSUER_DATABASE_URL=sqlite:///./issuer.db

# --- Services ---
REGISTRY_URL=http://localhost:8001
ISSUER_URL=http://localhost:8002
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# --- Behaviour ---
DEMO_MODE=true
CURRENT_ACADEMIC_YEAR=2026-27
JWT_EXPIRE_MINUTES=480
CONSENT_REQUEST_TTL_HOURS=72
VERIFY_TOKEN_TTL_MINUTES=15
LOG_LEVEL=info

# OCR for scanned documents. Leave empty if tesseract is on PATH or installed in
# C:\Program Files\Tesseract-OCR (checked automatically).
TESSERACT_CMD=

# Password hashing cost (12 in production; tests lower it for speed)
BCRYPT_ROUNDS=12
